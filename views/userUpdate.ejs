<!DOCTYPE html>
<html lang="en">
<%- include('./partials/head.ejs') %>
<body>
  <%- include('./partials/nav.ejs') %>
  <h3><%= title%></h3>
  <form action="/users/<%= data.id %>/update" method="POST">
    <input type="text" name="input--username" placeholder="<%= data.username %>" />
    <input type="text" name="current--username" value="<%= data.username %>" hidden/>
    <button type="submit">Submit</button>
  </form>

  <%- include('./partials/form-error.ejs') %>
  
</body>
</html>