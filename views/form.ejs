<!DOCTYPE html>
<html lang="en">
<%- include('./partials/head.ejs') %>
<body>
  <%- include('./partials/nav.ejs') %>
  <h1><%= title %></h1>
  <form method="POST" action="/new">
    <label for="input--author">Author</label>
    <input name="input--author" required/>

    <label for="input--msg">Message</label>
    <input name="input--msg" required/>
    
    <label for="input--age">Age</label>
    <input name="input--age" required/>
    
    <label for="input--email">Email</label>
    <input name="input--email" required/>
    
    <label for="input--bio">Bio</label>
    <input name="input--bio" required/>
    
    <button type="submit">Submit</button>
  </form>

  <%- include('./partials/form-error.ejs') %>

</body>
</html>