<!DOCTYPE html>
<html lang="en">
<%- include('./partials/head.ejs') %>
<body>
  <h1><%= title %></h1>
  <% messages.forEach(msg => {%>
    <a href="/<%= msg.id%>">
      <h3 class="user--name"><%= msg.user%></h3>
      <p class="msg--date"><%= msg.date%></p>
      <p class="msg--text"><%= msg.text%></p>
    </a>
  <% }) %>
</body>
</html>