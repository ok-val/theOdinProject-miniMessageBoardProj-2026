<!DOCTYPE html>
<html lang="en">
<%- include('./partials/head.ejs') %>
<body>
  <%- include('./partials/nav.ejs') %>
  <% messages.forEach((msg) => {%>
    <h3><a href="/users/<%= msg.id %>"><%= msg.username %></a></h3>
    <ul>
      <li><%= msg.age %></li>
      <li><%= msg.email %></li>
      <li><%= msg.bio %></li>
        <a href="/users/<%= msg.id %>/update">Update</a>
    </ul>
  <% }) %>
  
</body>
</html>